{
  "//": "ネットワークアクセス可否評価 findings.json テンプレート（ユースケース 003）。collector が target/pathLayers[].rulesEvaluated を確定し、evaluator が pathLayers[].decision/matched・overall・gap・proposals・summary を確定する。report-writer は読み取り専用でこの実データから HTML/CSV を生成する。{{TOKEN}} は実値へ置換し、配列は実データ数だけ要素を複製する（このコメントキー \"//\" と \"_example\" は出力から削除する）。",
  "schemaVersion": "1.0",
  "usecase": "003-network-access-evaluation",
  "metadata": {
    "generatedAt": "{{META_DATETIME}}",
    "reportFolder": "{{REPORT_FOLDER}}",
    "scope": {
      "tenantId": "{{TENANT_ID}}",
      "subscriptionId": "{{SUBSCRIPTION_ID}}",
      "subscriptionName": "{{SUBSCRIPTION_NAME}}",
      "resourceGroup": "{{RESOURCE_GROUP}}"
    }
  },
  "target": {
    "resourceId": "{{TARGET_RESOURCE_ID}}",
    "resourceType": "{{TARGET_RESOURCE_TYPE}}",
    "name": "{{TARGET_NAME}}",
    "resourceGroup": "{{TARGET_RG}}",
    "location": "{{TARGET_LOCATION}}",
    "publicExposure": {
      "hasPublicIp": false,
      "publicIps": [],
      "frontDoor": false,
      "appGateway": false,
      "loadBalancer": false,
      "notes": "{{EXPOSURE_NOTES}}"
    }
  },
  "query": {
    "endpointInput": "{{ENDPOINT_INPUT}}",
    "inputType": "IP",
    "resolvedIps": [],
    "fqdn": "",
    "direction": "Inbound",
    "port": null,
    "protocol": "Any",
    "desiredState": "CheckOnly"
  },
  "capabilityDetection": {
    "resourceGraph": "利用可",
    "nsg": "利用可",
    "azureFirewall": "未構成",
    "appServiceAccessRestrictions": "対象外",
    "apiManagement": "対象外",
    "paasFirewall": "対象外",
    "routeTable": "未構成"
  },
  "pathLayers": [
    {
      "_example": "collector が rulesEvaluated までを確定、evaluator が matched/decision/reason を確定する。layer は評価順（送信元側→対象側）に並べる。",
      "order": 1,
      "layer": "NSG(subnet)",
      "control": "{{LAYER_CONTROL}}",
      "applicable": true,
      "rulesEvaluated": [
        {
          "name": "{{RULE_NAME}}",
          "priority": 100,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceOrDestination": "{{SOURCE_OR_DEST}}",
          "portRange": "443",
          "matched": false
        }
      ],
      "matched": { "rule": "{{MATCHED_RULE}}", "action": "Deny", "priority": 65500 },
      "decision": "Deny",
      "reason": "{{LAYER_REASON}}",
      "source": "{{LAYER_SOURCE}}"
    }
  ],
  "overall": {
    "decision": "Denied",
    "matchedLayer": "{{OVERALL_MATCHED_LAYER}}",
    "reason": "{{OVERALL_REASON}}"
  },
  "gap": {
    "desiredState": "CheckOnly",
    "meets": true,
    "responsibleLayers": []
  },
  "proposals": [
    {
      "_example": "期待状態≠現状のときに evaluator が生成。considerations は『何を判断すべきか』のチェックリスト。azCli/bicep は提案（実行しない）。",
      "layer": "NSG(subnet)",
      "considerations": [
        "{{CONSIDERATION_1}}",
        "{{CONSIDERATION_2}}"
      ],
      "changeSummary": "{{CHANGE_SUMMARY}}",
      "azCli": "{{AZ_CLI}}",
      "bicep": "{{BICEP}}",
      "tradeoff": "{{TRADEOFF}}",
      "reference": "{{REFERENCE_URL}}"
    }
  ],
  "consistencyChecks": [],
  "summary": {
    "overallDecision": "Denied",
    "layerCount": 0,
    "denyLayerCount": 0,
    "proposalCount": 0,
    "meetsDesired": true
  }
}
