{
  // Azure MCP Server definition (committed for public sharing / opt-in use).
  // VS Code asks for confirmation before starting the server; it is not forced.
  //
  // Prerequisite: authenticate to Azure first, e.g. `az login`.
  // The server discovers your local Azure credentials (Azure CLI / VS Code, etc.).
  //
  // Docs: https://learn.microsoft.com/azure/developer/azure-mcp-server/
  "servers": {
    "Azure MCP Server": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    // Microsoft Release Communications (MRC) MCP Server: used by usecase 002
    // (service retirements / EOL for managed services) and usecase 005
    // (Azure retirement report from Azure Updates).
    // Remote streamable HTTP transport, no authentication required.
    // Docs: https://learn.microsoft.com/microsoft-365/admin/manage/mrc-mcp
    "Microsoft Release Communications": {
      "type": "http",
      "url": "https://www.microsoft.com/releasecommunications/mcp"
    },
    // Microsoft Learn MCP Server: used by usecase 005 (optional) to supplement
    // official migration guidance when a retirement notice has no official link.
    // Remote streamable HTTP transport, no authentication required.
    // Docs: https://learn.microsoft.com/training/support/mcp
    "Microsoft Learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
